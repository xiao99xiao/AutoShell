    "The existing configuration cannot be read and will not be overwritten. Repair tasks.json and restart AutoShell.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing configuration cannot be read and will not be overwritten. Repair tasks.json and restart AutoShell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原配置无法读取，已阻止覆盖。请先修复 tasks.json 并重启 App。"
          }
        }
      }
    },
    "The interval starts when you save these settings or start the task. Each restart waits for the current process to stop before starting a new one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interval starts when you save these settings or start the task. Each restart waits for the current process to stop before starting a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存设置或启动任务时开始计时。每次重启都会等待当前进程结束，再启动新进程。"
          }
        }
      }
    },
    "The shell must be an absolute path to an executable file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell must be an absolute path to an executable file."
