            "value": "正在停止"
          }
        }
      }
    },
    "Stopping the task pauses the schedule. Starting it resumes the schedule. Unexpected exits follow the task’s failure settings. An overdue restart runs once after your Mac wakes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping the task pauses the schedule. Starting it resumes the schedule. Unexpected exits follow the task’s failure settings. An overdue restart runs once after your Mac wakes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止任务会暂停计时，启动任务后恢复。意外退出仍按任务的失败处理设置执行。睡眠期间到期的重启会在 Mac 唤醒后执行一次。"
          }
        }
      }
    },
    "Stopping; remaining processes will be forced to quit after 5 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping; remaining processes will be forced to quit after 5 seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止；5 秒后仍未退出将强制结束。"
          }
        }
      }
    },
